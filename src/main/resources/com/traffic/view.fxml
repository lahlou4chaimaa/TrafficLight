<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressBar?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Circle?>
<?import javafx.scene.text.Font?>

<VBox alignment="TOP_CENTER" spacing="15" style="-fx-background-color: #2c3e50;"
      xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.traffic.controller.TrafficController">

    <padding><Insets top="20" right="20" bottom="20" left="20"/></padding>

    <VBox alignment="CENTER" spacing="5">
        <Label text="🚦 AI TRAFFIC CONTROLLER" textFill="WHITE">
            <font><Font name="System Bold" size="24.0"/></font>
        </Label>
        <Label fx:id="statusLabel" text="System: Ready" textFill="#bdc3c7"/>
    </VBox>

    <Separator opacity="0.3"/>

    <HBox spacing="50" alignment="CENTER" style="-fx-padding: 10;">

        <VBox alignment="CENTER" spacing="10">
            <Label text="MAIN AVENUE" textFill="#ecf0f1" style="-fx-font-weight: bold;"/>
            <VBox spacing="10" alignment="CENTER"
                  style="-fx-background-color: #000; -fx-padding: 15; -fx-background-radius: 20; -fx-border-color: #555; -fx-border-width: 3;">
                <Circle fx:id="mainRed" radius="25" fill="#400000" stroke="BLACK"/>
                <Circle fx:id="mainYellow" radius="25" fill="#403a00" stroke="BLACK"/>
                <Circle fx:id="mainGreen" radius="25" fill="#003300" stroke="BLACK"/>
            </VBox>
            <VBox spacing="2">
                <Label fx:id="mainDensityLabel" text="Traffic: 0%" textFill="WHITE" style="-fx-font-size: 10px;"/>
                <ProgressBar fx:id="mainDensityBar" prefWidth="100" progress="0.0" style="-fx-accent: #3498db;"/>
            </VBox>
        </VBox>

        <VBox alignment="CENTER" spacing="10">
            <Label text="CROSS STREET" textFill="#ecf0f1" style="-fx-font-weight: bold;"/>
            <VBox spacing="10" alignment="CENTER"
                  style="-fx-background-color: #000; -fx-padding: 15; -fx-background-radius: 20; -fx-border-color: #555; -fx-border-width: 3;">
                <Circle fx:id="crossRed" radius="25" fill="#400000" stroke="BLACK"/>
                <Circle fx:id="crossYellow" radius="25" fill="#403a00" stroke="BLACK"/>
                <Circle fx:id="crossGreen" radius="25" fill="#003300" stroke="BLACK"/>
            </VBox>
            <VBox spacing="2">
                <Label fx:id="crossDensityLabel" text="Traffic: 0%" textFill="WHITE" style="-fx-font-size: 10px;"/>
                <ProgressBar fx:id="crossDensityBar" prefWidth="100" progress="0.0" style="-fx-accent: #e67e22;"/>
            </VBox>
        </VBox>

    </HBox>

    <HBox spacing="20" alignment="CENTER">
        <Button fx:id="startButton" text="▶ Start AI Cycle" onAction="#onStartClick"
                style="-fx-background-color: #27ae60; -fx-text-fill: white; -fx-font-weight: bold;"/>
        <Button fx:id="tramButton" text="🚋 Force Tram Priority" onAction="#onTramClick"
                style="-fx-background-color: #d35400; -fx-text-fill: white; -fx-font-weight: bold;"/>
    </HBox>

    <Separator opacity="0.3"/>

    <HBox fx:id="dashboardContainer" spacing="20" alignment="CENTER" VBox.vgrow="ALWAYS"
          style="-fx-padding: 10; -fx-background-color: rgba(255,255,255,0.05); -fx-background-radius: 10;"/>

</VBox>